\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{sb2nov-cv}[2026/06/10 Minimal single-column CV layout]

\RequirePackage[a4paper,margin=1.45cm]{geometry}
\RequirePackage{titlesec}
\RequirePackage{enumitem}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage{array}
\RequirePackage{fancyhdr}
\RequirePackage{xcolor}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

\urlstyle{same}
\raggedbottom
\raggedright
\setlength{\tabcolsep}{0pt}
\setlength{\parindent}{0pt}

\titleformat{\section}
  {\vspace{-2pt}\scshape\raggedright\large}
  {}{0em}{}
  [\color{black}\titlerule\vspace{-5pt}]
\titlespacing*{\section}{0pt}{9pt}{5pt}

\setlist[itemize]{
  leftmargin=1.4em,
  itemsep=1pt,
  topsep=2pt,
  parsep=0pt,
  partopsep=0pt
}
\renewcommand{\labelitemii}{$\circ$}

\newcommand{\cvneedspace}[1]{%
  \par
  \begingroup
    \dimen0=\pagegoal
    \advance\dimen0 by -\pagetotal
    \ifdim\dimen0<#1\relax
      \newpage
    \fi
  \endgroup
}

% The second argument is an icon in the dual-column source. The minimal
% single-column layout intentionally ignores it.
\newcommand{\sectionTitle}[2]{\section{#1}}

\newenvironment{scholarship}
  {\begin{itemize}[leftmargin=0pt,label={},itemsep=3pt]}
  {\end{itemize}}

\newcommand{\scholarshipentry}[2]{%
  \item
  \begin{tabular*}{\textwidth}{@{}p{0.78\textwidth}@{\extracolsep{\fill}}r@{}}
    #2 & \textbf{#1}
  \end{tabular*}
}

\newenvironment{experiences}
  {\begin{itemize}[leftmargin=0pt,label={},itemsep=6pt]}
  {\end{itemize}}

\newcommand{\experience}[7]{%
  \cvneedspace{7\baselineskip}
  \item
  \begin{tabular*}{\textwidth}{@{}l@{\extracolsep{\fill}}r@{}}
    \textbf{#3} & \textbf{#5 -- #1} \\
    \textit{\small #2} & \textit{\small #4}
  \end{tabular*}\vspace{-3pt}
  #6
  \vspace{-2pt}\par{\small\textit{Technologies:} #7}
}

\newcommand{\emptySeparator}{}

\newenvironment{projects}
  {\begin{itemize}[leftmargin=0pt,label={},itemsep=7pt]}
  {\end{itemize}}

\newcommand{\project}[5]{%
  \cvneedspace{7\baselineskip}
  \item
  \begin{tabular*}{\textwidth}{@{}p{0.76\textwidth}@{\extracolsep{\fill}}>{\raggedleft\arraybackslash}p{0.22\textwidth}@{}}
    \textbf{#1} & \textit{\small #2}
  \end{tabular*}
  \if\relax\detokenize{#3}\relax\else
    \vspace{1pt}\par{\small #3}
  \fi
  \vspace{1pt}\par{\small #4}
  \vspace{1pt}\par{\small\textit{Technologies:} #5}
}

\newcommand{\website}[2]{\href{#1}{#2}\hspace{1em}}

\newenvironment{referees}
  {\begin{itemize}[leftmargin=0pt,label={},itemsep=3pt]}
  {\end{itemize}}

\newcommand{\referee}[4]{%
  \cvneedspace{3\baselineskip}
  \item
  \begin{tabular*}{\textwidth}{@{}l@{\extracolsep{\fill}}r@{}}
    \textbf{#1}, \textit{#2}, #3 & \href{mailto:#4}{#4}
  \end{tabular*}
}

\newenvironment{skills}
  {\begin{itemize}[leftmargin=0pt,label={},itemsep=1pt]}
  {\end{itemize}}
\newcommand{\skill}[2]{\item #1}

\newcommand{\twocolumnsection}[2]{#1#2}

\newenvironment{keywords}
  {\begin{itemize}[leftmargin=0pt,label={},itemsep=2pt]}
  {\end{itemize}}
\newcommand{\keywordsentry}[2]{\item\textbf{#1}: #2}
